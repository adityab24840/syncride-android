# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Google Cloud project with Maps SDK for Android + Directions API enabled.
# Both are covered by Google's monthly free credit at personal-project volume.
MAPS_API_KEY=your_key_here

# Base URL of the SyncRide Express/Socket.IO backend.
SYNCRIDE_API_BASE_URL=http://10.0.2.2:4000

# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Base URL of the SyncRide Express/Socket.IO backend.
SYNCRIDE_API_BASE_URL=http://10.0.2.2:4000

# OSRM routing server. Defaults to the free public demo server (no key,
# but rate-limited — swap in a self-hosted instance if usage grows).
OSRM_BASE_URL=https://router.project-osrm.org
